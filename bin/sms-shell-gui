#!/bin/sh
# sms-shell-gui launcher (GUI entry, POSIX): python sms-shell-gui.py (PyQt6 shell_qt.py + shell_qt_fax.py fax-console mirror, batch41 chassis = crt feeder on top + left/right QSplitter below (left paper-roll A with LCD/LED/cutter, right = preview D with self-drawn line numbers over terminal E, both panes split/fold, right splitter holds three resident non-collapsible cells (childrenCollapsible=False) C e-ink (Ctrl+I only focuses, never hides) over D preview over E terminal, control panel/drawer on demand via Ctrl+M, bottom status strip removed and its hints moved to the e-ink mini-label eink_stat with the six-state paper-feed queue idle/feed/print/advance/tear/jam; batch45 preview lookup on a bare name walks de-duplicated candidate dirs (workspace root -> SMS_TMP -> cwd; shell_qt.py _pv_candidates L961 / previewOpen L972, all-miss = explicit error + built-in fallback, never silent); batch46 lamp parity drives the QQ lamp in-process via web_shell /api/qq (pollQQ L1392 / pollAll L1417), gate led_driven_n = led_built_n = led_lamps = 7 (gate L1851); Ctrl+V cycles five views roll/feeder/e-ink/preview/terminal; zero top bar kept from batch40: native menu bar and brand strip removed in favour of the Ctrl+K command palette and the right-click body menu) (no token gate, preview data in-process via /api/files /api/file /api/detail, terminal runs QProcess on the same shell_core.handle route and is reaped on closeEvent), batch40 legacy shortcuts kept at QAction level + batch39 three views: paper cutter CUT blade / CRT green-on-black feeder / E-INK 3-section panel, no new port and no bare child process), PySide6 shell_gui.py fallback, no Qt -> sms-shell-tui); api or no python -> locate.py.
D=$(dirname "$0")
if [ "${1:-}" = "api" ]; then
  export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
  exec python -B "$D/locate.py" "$@"
fi
if command -v python >/dev/null 2>&1; then
  PYTHONUTF8=1 PYTHONIOENCODING=utf-8 exec python -B "$D/sms-shell-gui.py" "$@"
fi
echo "sms-shell-gui: python not found - falling back to native console shell (sms_shell.ps1)" >&2
for PS in pwsh powershell; do
  if command -v "$PS" >/dev/null 2>&1; then
    if [ "$#" -eq 0 ]; then exec "$PS" -NoProfile -ExecutionPolicy Bypass -File "$D/sms_shell.ps1"; fi
    exec "$PS" -NoProfile -ExecutionPolicy Bypass -File "$D/sms_shell.ps1" "$*"
  fi
done
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
exec python -B "$D/locate.py" "$@"
