#!/bin/sh
# sms-shell-gui launcher (GUI entry, POSIX): python sms-shell-gui.py (PyQt6 shell_qt.py + shell_qt_fax.py fax-console mirror, zero-topbar three-zone chassis (paper-roll / crt feeder / e-ink permanent; control panel and drawer on demand via Ctrl+M; native menu bar and brand strip removed in favour of the Ctrl+K command palette and the right-click body menu) (no token gate), batch40: legacy shortcuts kept at QAction level + batch39 three views: paper cutter CUT blade / CRT green-on-black feeder / E-INK 3-section panel, all in-process, no new port or process), PySide6 shell_gui.py fallback, no Qt -> sms-shell-tui); api or no python -> locate.py.
D=$(dirname "$0")
if [ "${1:-}" = "api" ]; then
  export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
  exec python -B "$D/locate.py" "$@"
fi
if command -v python >/dev/null 2>&1; then
  PYTHONUTF8=1 PYTHONIOENCODING=utf-8 exec python -B "$D/sms-shell-gui.py" "$@"
fi
echo "sms-shell-gui: python not found - falling back to native console shell (sms_shell.ps1)" >&2
for PS in pwsh powershell; do
  if command -v "$PS" >/dev/null 2>&1; then
    if [ "$#" -eq 0 ]; then exec "$PS" -NoProfile -ExecutionPolicy Bypass -File "$D/sms_shell.ps1"; fi
    exec "$PS" -NoProfile -ExecutionPolicy Bypass -File "$D/sms_shell.ps1" "$*"
  fi
done
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
exec python -B "$D/locate.py" "$@"
